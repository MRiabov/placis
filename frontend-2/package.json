{
  "name": "@placis/frontend-2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:goldens": "GOLDEN_CAPTURE=1 playwright test --update-snapshots",
    "test:e2e:auth": "playwright test -c playwright.auth.config.ts",
    "typegen": "openapi-typescript ../openapi.json -o src/generated/api-types.ts"
  },
  "dependencies": {
    "@clerk/react": "^6.14.7",
    "@hookform/resolvers": "^5.9.1",
    "@placis/website-components": "workspace:*",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/backend": "^3.16.12",
    "@clerk/testing": "^2.2.30",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
