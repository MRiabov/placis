{
  "name": "@placis/demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5176",
    "check": "biome check . && tsc --noEmit && knip && node scripts/check-files.mjs && node scripts/check-tokens.mjs && bash scripts/check-dont-say.sh",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name placis-demo"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.32",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "knip": "^6.32.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
