---
import { onboardingHref } from "../lib/appOrigin";
import {
  HAIRLINE_BORDER_CLASS,
  MARKETING_CARD_BODY_CLASS,
  MARKETING_CARD_H3_CLASS,
  MARKETING_PANEL_LIST_CLASS,
  MARKETING_STATEMENT_H2_CLASS,
  RAISED_OUTLINE_CLASS,
  RAISED_PRIMARY_CLASS,
  SURFACE_RADIUS_CLASS,
} from "../lib/marketingSite";

const paths = [
  {
    title: "Start on your own",
    body: "Answer a few questions and get a complete build to review.",
    features: [
      "Complete build from a five minute chat",
      "Edit anything before it goes live",
      "Publish only when you approve",
    ],
    ctaLabel: "Sign up",
    ctaHref: onboardingHref(),
    primary: true,
  },
  {
    title: "Get extra support",
    body: "We walk you through the client interview and gather your photos and proof with you.",
    features: [
      "Guided client interview at your pace",
      "Photos, certifications, and reviews collected for you",
      "Priority help before you go live",
    ],
    ctaLabel: "Contact us",
    ctaHref: "/support/",
    primary: false,
  },
];
---

<section class="scroll-mt-14 bg-background pt-12 pb-12 sm:pt-20 sm:pb-20">
  <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-8">
    <h2 class={`mx-auto max-w-2xl text-center ${MARKETING_STATEMENT_H2_CLASS}`}>
      Two ways to get started
    </h2>
    <div class="mt-6 grid gap-5 sm:mt-10 sm:grid-cols-2">
      {
        paths.map((path) => (
          <div
            class={`${SURFACE_RADIUS_CLASS} ${HAIRLINE_BORDER_CLASS} flex flex-col bg-card p-5 sm:p-10`}
          >
            <h3 class={MARKETING_CARD_H3_CLASS}>{path.title}</h3>
            <p class={`mt-3 ${MARKETING_CARD_BODY_CLASS}`}>{path.body}</p>
            <ul class="mt-6 space-y-2">
              {path.features.map((feature) => (
                <li class="flex items-center gap-2.5">
                  <svg
                    aria-hidden="true"
                    class="size-3.5 shrink-0 text-zinc-400 dark:text-zinc-500"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                  <span class={MARKETING_PANEL_LIST_CLASS}>{feature}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-8">
              <a
                class={`inline-flex h-11 items-center rounded-full px-6 font-medium text-sm ${path.primary ? RAISED_PRIMARY_CLASS : RAISED_OUTLINE_CLASS}`}
                href={path.ctaHref}
              >
                {path.ctaLabel}
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
