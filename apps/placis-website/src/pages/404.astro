---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not found — Placis">
  <main class="grid min-h-[60vh] place-items-center px-6 text-center">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Not found</h1>
      <p class="mt-3 text-[15px] text-zinc-500 dark:text-zinc-400">
        That path is not on the Placis website.
      </p>
      <a class="mt-6 inline-block font-medium underline underline-offset-4" href="/">
        Back to Placis
      </a>
    </div>
  </main>
</Layout>
