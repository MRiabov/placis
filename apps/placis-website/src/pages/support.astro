---
import MinimalFooter from "../components/MinimalFooter.astro";
import Layout from "../layouts/Layout.astro";
import {
  CONTROL_RADIUS_CLASS,
  MARKETING_HERO_H1_CLASS,
  MARKETING_MAIN_CLASS,
  RAISED_PRIMARY_CLASS,
  SUPPORT_EMAIL,
} from "../lib/marketingSite";
---

<Layout title="Support — Placis" description="Email Placis support.">
  <main class={MARKETING_MAIN_CLASS}>
    <section class="flex flex-1 items-center justify-center px-6 py-16 sm:py-24">
      <div class="w-full max-w-[34rem] text-center">
        <h1 class={MARKETING_HERO_H1_CLASS}>We&apos;re here to help.</h1>
        <p class="mx-auto mt-4 max-w-md text-[15px] text-zinc-500 leading-6 dark:text-zinc-400">
          Questions about your build, account, or getting set up? Email us and our
          support team will get back to you.
        </p>
        <a
          class={`mt-8 inline-flex h-11 items-center justify-center px-6 font-medium text-[15px] ${CONTROL_RADIUS_CLASS} ${RAISED_PRIMARY_CLASS}`}
          href={`mailto:${SUPPORT_EMAIL}`}
        >
          Email {SUPPORT_EMAIL}
        </a>
      </div>
    </section>
    <MinimalFooter />
  </main>
</Layout>
