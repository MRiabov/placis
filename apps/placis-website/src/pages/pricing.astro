---
import { PricingGrid } from "../components/PricingGrid";
import SiteFooter from "../components/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";
import { MARKETING_HEADING_FLAT_CLASS, MARKETING_MAIN_CLASS } from "../lib/marketingSite";
---

<Layout
  description="Subscription tiers and subscription prices for Placis."
  title="Pricing — Placis"
>
  <main class={MARKETING_MAIN_CLASS}>
    <section class="flex flex-1 flex-col items-center px-4 pt-10 pb-16 text-center sm:px-8 sm:pt-16 sm:pb-24">
      <div class="flex w-full max-w-4xl flex-col items-center">
        <h1 class={`mx-auto max-w-[22ch] ${MARKETING_HEADING_FLAT_CLASS} text-2xl leading-tight sm:text-3xl`}>
          Pricing
        </h1>
        <p class="mt-3 max-w-md text-[15px] text-zinc-500 leading-6 dark:text-zinc-400">
          Pick a subscription tier. Usage credit is included each month; unused
          usage credit carries over.
        </p>
        <PricingGrid client:load />
      </div>
    </section>
    <SiteFooter />
  </main>
</Layout>
