---
import { TopBar } from "../components/TopBar";
import { SITE_FONT } from "../lib/marketingSite";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Placis", description = "Done-for-you marketing and websites for construction companies." } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://placis.com").href;
---

<!doctype html>
<html class="page-canvas" lang="en" style={`font-family: ${SITE_FONT}`}>
  <head>
    <meta charset="UTF-8" />
    <meta
      content="width=device-width, initial-scale=1, viewport-fit=cover"
      name="viewport"
    />
    <meta content="#ffffff" media="(prefers-color-scheme: light)" name="theme-color" />
    <meta content="#181818" media="(prefers-color-scheme: dark)" name="theme-color" />
    <link
      as="font"
      crossorigin="anonymous"
      href="/fonts/Satoshi-Variable.woff2"
      rel="preload"
      type="font/woff2"
    />
    <link href="/favicon.svg" rel="icon" />
    <link href={canonical} rel="canonical" />
    <title>{title}</title>
    <meta content={description} name="description" />
  </head>
  <body class="page-canvas" style={`font-family: ${SITE_FONT}`}>
    <TopBar client:load />
    <slot />
  </body>
</html>
