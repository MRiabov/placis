{
  "name": "@placis/contractor-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "pnpm --dir ../../packages/website-components build && astro check && astro build",
    "check": "pnpm --dir ../../packages/website-components build && astro check",
    "cf:deploy:production": "node ../../scripts/deploy_contractor_website_cloudflare.mjs production",
    "cf:deploy:staging": "node ../../scripts/deploy_contractor_website_cloudflare.mjs staging",
    "cf:dev": "pnpm build && wrangler dev",
    "cf:types": "wrangler types ./src/worker-configuration.d.ts --include-runtime false",
    "deploy:local": "node ../../scripts/deploy_contractor_website_local.mjs",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.4",
    "@astrojs/react": "^6.0.4",
    "@placis/website-components": "workspace:*",
    "astro": "^7.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  }
}
