---
import "../styles/global.css";

export const prerender = false;

Astro.response.status = 404;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="placis-contractor-website" name="placis:bundle" />
    <meta content="false" name="placis:tenant-specific-build" />
    <link href="/favicon.ico" rel="icon" />
    <title>Website not found</title>
  </head>
  <body>
    <main class="grid min-h-screen place-items-center px-4 text-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">
          Website unavailable
        </p>
        <h1 class="mt-3 text-3xl font-bold text-slate-950">No published website found</h1>
        <p class="mt-3 max-w-md text-sm leading-6 text-slate-600">
          This hostname is reserved for a contractor website, but there is no published
          website for this path.
        </p>
      </div>
    </main>
  </body>
</html>
