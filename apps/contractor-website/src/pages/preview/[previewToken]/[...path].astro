---
import {
  loadPublicSiteComponents,
  pageDescription,
  pageSections,
  pageTitle,
  PublicSiteRenderer,
  resolveManifestPage,
  type PublicSiteManifest,
} from "@placis/website-components";
import PublicSiteClientBehaviors from "../../../components/PublicSiteClientBehaviors.astro";
import "../../../styles/global.css";
import {
  publicSiteApiBaseUrl,
  resolvePreviewWebsite,
  type PublicSiteRuntimeEnv,
} from "../../../lib/publicSiteApi";
import { env } from "cloudflare:workers";

export const prerender = false;

const runtimeEnv = env as PublicSiteRuntimeEnv;
const apiBaseUrl = publicSiteApiBaseUrl(runtimeEnv);
const previewToken = Astro.params.previewToken ?? "";
const pathParam = Astro.params.path;
const requestedPath = pathParam ? `/${pathParam.replace(/^\/+/, "")}` : "/";
const resolved = previewToken
  ? await resolvePreviewWebsite({ apiBaseUrl, previewToken })
  : null;
const manifest: PublicSiteManifest = resolved?.manifest ?? {};
const page = resolveManifestPage(manifest, requestedPath);
const sections = pageSections(page);
const loadedComponents = await loadPublicSiteComponents(sections);
const title = page ? `${pageTitle(manifest, page)} Preview` : "Website preview";
const description = page
  ? pageDescription(manifest, page)
  : "Signed website preview link";

Astro.response.headers.set("cache-control", "private, no-store");
Astro.response.headers.set("x-robots-tag", "noindex, nofollow");
if (!page) {
  Astro.response.status = 404;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content={description} name="description" />
    <meta content="noindex,nofollow" name="robots" />
    <meta content="placis-contractor-website-preview" name="placis:bundle" />
    <meta content="false" name="placis:tenant-specific-build" />
    <link href="/favicon.ico" rel="icon" />
    <title>{title}</title>
  </head>
  <body>
    {
      page ? (
        <PublicSiteRenderer
          context={{
            formSubmitBasePath: `${apiBaseUrl}/api/v1/public/forms`,
            mode: "preview",
            path: requestedPath,
          }}
          loadedComponents={loadedComponents}
          manifest={manifest}
          page={page}
        />
      ) : (
        <main class="public-site-root grid min-h-screen place-items-center px-4 text-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">
              Website preview unavailable
            </p>
            <h1 class="mt-3 text-3xl font-bold text-slate-950">Preview link could not be loaded</h1>
            <p class="mt-3 max-w-md text-sm leading-6 text-slate-600">
              This signed preview may have expired, or the website draft may not be ready yet.
            </p>
          </div>
        </main>
      )
    }

    <PublicSiteClientBehaviors />
  </body>
</html>
