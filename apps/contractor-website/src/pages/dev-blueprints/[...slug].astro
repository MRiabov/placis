---
import {
  loadPublicSiteComponents,
  pageSections,
  pageTitle,
  PublicSiteRenderer,
} from "@placis/website-components";
import "../../styles/global.css";
import {
  devBlueprintPath,
  findDevBlueprint,
  listDevBlueprints,
  listDevBlueprintFixtures,
  listDevBlueprintThemes,
  type DevBlueprintSummary,
} from "../../lib/devBlueprints";
import type { PublicSiteRuntimeEnv } from "../../lib/publicSiteApi";

export const prerender = false;

const runtimeEnv = Astro.locals.runtime?.env as PublicSiteRuntimeEnv | undefined;
const publicSiteEnv = runtimeEnv?.PUBLIC_SITE_ENV ?? import.meta.env.PUBLIC_SITE_ENV;
const enabled =
  import.meta.env.DEV ||
  publicSiteEnv === "local" ||
  ["127.0.0.1", "localhost", "::1"].includes(Astro.url.hostname);
const rawSlug = Astro.params.slug ?? "";
const segments = rawSlug.split("/").filter(Boolean);
const blueprints = listDevBlueprints();
const fixtures = listDevBlueprintFixtures();
const themes = listDevBlueprintThemes();
const themeOverride = Astro.url.searchParams.get("theme");
const fixtureId = Astro.url.searchParams.get("fixture");
const selectedFixtureId = fixtures.some((fixture) => fixture.id === fixtureId) ? fixtureId : null;
const selectedThemeId = themes.some((theme) => theme.id === themeOverride) ? themeOverride : null;
const match = enabled ? findDevBlueprint(segments, selectedThemeId, selectedFixtureId) : null;
const page = match?.page ?? null;
const manifest = match?.manifest;
const loadedComponents = page ? await loadPublicSiteComponents(pageSections(page)) : [];
const title = page && manifest ? pageTitle(manifest, page) : "Public site blueprints";

if (!enabled || (segments.length > 0 && !match) || (match && !page)) {
  Astro.response.status = 404;
}

function groupedBlueprints(items: DevBlueprintSummary[]) {
  return Object.entries(
    items.reduce<Record<string, DevBlueprintSummary[]>>((groups, item) => {
      groups[item.pageType] = [...(groups[item.pageType] ?? []), item];
      return groups;
    }, {}),
  ).sort(([a], [b]) => a.localeCompare(b));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="noindex, nofollow" name="robots" />
    <meta content="placis-contractor-website-dev-templates" name="placis:bundle" />
    <title>{title}</title>
  </head>
  <body>
    {
      enabled && page && manifest && match ? (
        <>
          <aside class="dev-blueprint-bar">
            <a class="dev-blueprint-bar__home" href="/dev-blueprints/">
              All blueprints
            </a>
            <div class="dev-blueprint-bar__group dev-blueprint-bar__group--meta">
              <span class="dev-blueprint-bar__label">Blueprint</span>
              <strong>{match.summary.id}</strong>
              <span>{match.summary.relativeDir}</span>
            </div>
            <div class="dev-blueprint-bar__group">
              <span class="dev-blueprint-bar__label">Business</span>
              <nav aria-label="Fixture modes">
                <a
                  aria-current={!match.fixture ? "page" : undefined}
                  href={devBlueprintPath(
                    match.summary,
                    match.requestedPath,
                    null,
                    selectedThemeId,
                  )}
                >
                  Raw template
                </a>
                {fixtures.map((fixture) => (
                  <a
                    aria-current={fixture.id === match.fixture?.id ? "page" : undefined}
                    href={devBlueprintPath(
                      match.summary,
                      match.requestedPath,
                      fixture.id,
                      selectedThemeId,
                    )}
                    title={`${fixture.trade} · ${fixture.geography}`}
                  >
                    {fixture.businessName}
                  </a>
                ))}
              </nav>
            </div>
            <div class="dev-blueprint-bar__group dev-blueprint-bar__group--theme">
              <span class="dev-blueprint-bar__label">Theme</span>
              <nav aria-label="Theme views">
                <a
                  aria-current={!selectedThemeId ? "page" : undefined}
                  href={devBlueprintPath(
                    match.summary,
                    match.requestedPath,
                    match.fixture?.id,
                  )}
                  title={`Use the blueprint's source theme: ${match.summary.theme}`}
                >
                  Reference theme
                </a>
                {themes.map((theme) => (
                  <a
                    aria-current={theme.id === selectedThemeId ? "page" : undefined}
                    href={devBlueprintPath(
                      match.summary,
                      match.requestedPath,
                      match.fixture?.id,
                      theme.id,
                    )}
                  >
                    {theme.label}
                  </a>
                ))}
              </nav>
            </div>
            <div class="dev-blueprint-bar__group">
              <span class="dev-blueprint-bar__label">Pages</span>
              <nav aria-label="Blueprint pages">
                {match.summary.pages.map((item) => (
                  <a
                    aria-current={item.path === match.requestedPath ? "page" : undefined}
                    href={devBlueprintPath(
                      match.summary,
                      item.path,
                      match.fixture?.id,
                      selectedThemeId,
                    )}
                  >
                    {item.path}
                  </a>
                ))}
              </nav>
            </div>
          </aside>
          <PublicSiteRenderer
            context={{
              formSubmitBasePath: "/api/v1/public/forms",
              mode: "preview",
              path: match.requestedPath,
              tenantSlug: "dev-blueprints",
            }}
            loadedComponents={loadedComponents}
            manifest={manifest}
            page={page}
          />
        </>
      ) : enabled && segments.length === 0 ? (
        <main class="dev-blueprint-index">
          <header>
            <p>Placis public-site dev catalog</p>
            <h1>Blueprints</h1>
            <div class="dev-blueprint-fixtures" aria-label="Eval fixtures">
              <span>Fixture links use website generation eval facts:</span>
              <a
                aria-current={!selectedFixtureId ? "page" : undefined}
                href={selectedThemeId ? `/dev-blueprints/?theme=${encodeURIComponent(selectedThemeId)}` : "/dev-blueprints/"}
              >
                Raw template
              </a>
              {fixtures.map((fixture) => (
                <a
                  aria-current={fixture.id === selectedFixtureId ? "page" : undefined}
                  href={
                    selectedThemeId
                      ? `?fixture=${encodeURIComponent(fixture.id)}&theme=${encodeURIComponent(selectedThemeId)}`
                      : `?fixture=${encodeURIComponent(fixture.id)}`
                  }
                >
                  {fixture.businessName}
                </a>
              ))}
            </div>
            <div class="dev-blueprint-fixtures" aria-label="Theme views">
              <span>Theme views:</span>
              <a
                aria-current={!selectedThemeId ? "page" : undefined}
                href={selectedFixtureId ? `?fixture=${encodeURIComponent(selectedFixtureId)}` : "/dev-blueprints/"}
              >
                Reference theme
              </a>
              {themes.map((theme) => (
                <a
                  aria-current={theme.id === selectedThemeId ? "page" : undefined}
                  href={
                    selectedFixtureId
                      ? `?fixture=${encodeURIComponent(selectedFixtureId)}&theme=${encodeURIComponent(theme.id)}`
                      : `?theme=${encodeURIComponent(theme.id)}`
                  }
                >
                  {theme.label}
                </a>
              ))}
            </div>
          </header>
          {groupedBlueprints(blueprints).map(([pageType, items]) => (
            <section>
              <h2>{pageType}</h2>
              <div class="dev-blueprint-grid">
                {items.map((item) => (
                  <article>
                    <div>
                      <p>{item.relativeDir}</p>
                      <h3>{item.name}</h3>
                    </div>
                    <dl>
                      <div>
                        <dt>ID</dt>
                        <dd>{item.id}</dd>
                      </div>
                      <div>
                        <dt>Theme</dt>
                        <dd>{item.theme}</dd>
                      </div>
                      <div>
                        <dt>Components</dt>
                        <dd>{item.sectionIds.length}</dd>
                      </div>
                    </dl>
                    <nav aria-label={`Pages for ${item.name}`}>
                      {item.pages.map((pageItem) => (
                        <a
                          href={devBlueprintPath(
                            item,
                            pageItem.path,
                            selectedFixtureId,
                            selectedThemeId,
                          )}
                        >
                          {pageItem.path}
                        </a>
                      ))}
                    </nav>
                    {fixtures.length > 0 ? (
                      <nav aria-label={`Fixture pages for ${item.name}`}>
                        {fixtures.slice(0, 3).map((fixture) => (
                          <a
                            href={devBlueprintPath(
                              item,
                              item.pages[0]?.path,
                              fixture.id,
                              selectedThemeId,
                            )}
                          >
                            {fixture.businessName}
                          </a>
                        ))}
                      </nav>
                    ) : null}
                  </article>
                ))}
              </div>
            </section>
          ))}
        </main>
      ) : (
        <main class="public-site-root grid min-h-screen place-items-center px-4 text-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">
              Blueprint unavailable
            </p>
            <h1 class="mt-3 text-3xl font-bold text-slate-950">No dev blueprint found</h1>
            <p class="mt-3 max-w-md text-sm leading-6 text-slate-600">
              Open /dev-blueprints/ locally to choose a blueprint and page.
            </p>
          </div>
        </main>
      )
    }
    <script>
      import "../../scripts/publicEnhancements";
    </script>
  </body>
</html>

<style>
  .dev-blueprint-index {
    background: #f8fafc;
    color: #0f172a;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    min-height: 100vh;
    padding: 48px 28px 72px;
  }

  .dev-blueprint-index > header,
  .dev-blueprint-index > section {
    margin: 0 auto;
    max-width: 1180px;
  }

  .dev-blueprint-index > header p {
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .dev-blueprint-index h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: 0;
    line-height: 0.95;
    margin: 0 0 18px;
  }

  .dev-blueprint-fixtures {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 42px;
  }

  .dev-blueprint-fixtures span {
    color: #475569;
    font-size: 0.86rem;
    font-weight: 650;
  }

  .dev-blueprint-index h2 {
    border-top: 1px solid #cbd5e1;
    color: #334155;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    margin: 38px 0 18px;
    padding-top: 18px;
    text-transform: uppercase;
  }

  .dev-blueprint-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr));
  }

  .dev-blueprint-grid article {
    background: #fff;
    border: 1px solid #dbe3ef;
    border-radius: 8px;
    display: grid;
    gap: 18px;
    padding: 18px;
  }

  .dev-blueprint-grid article > div p {
    color: #64748b;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin: 0 0 8px;
    text-transform: uppercase;
  }

  .dev-blueprint-grid h3 {
    font-size: 1.2rem;
    line-height: 1.2;
    margin: 0;
  }

  .dev-blueprint-grid dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .dev-blueprint-grid dl div {
    display: grid;
    gap: 8px;
    grid-template-columns: 82px minmax(0, 1fr);
  }

  .dev-blueprint-grid dt {
    color: #64748b;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .dev-blueprint-grid dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .dev-blueprint-grid nav,
  .dev-blueprint-bar nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .dev-blueprint-grid a,
  .dev-blueprint-bar a,
  .dev-blueprint-fixtures a {
    align-items: center;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    color: #0f172a;
    display: inline-flex;
    font-size: 0.82rem;
    font-weight: 700;
    min-height: 34px;
    padding: 0 12px;
    text-decoration: none;
  }

  .dev-blueprint-bar {
    --dev-blueprint-toolbar-height: 52px;

    align-items: center;
    background: #f8fafc;
    border-bottom: 1px solid #cbd5e1;
    box-sizing: border-box;
    color: #0f172a;
    display: flex;
    flex-wrap: nowrap;
    gap: 10px 14px;
    height: var(--dev-blueprint-toolbar-height);
    inset: 0 0 auto;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 8px 14px;
    position: fixed;
    scrollbar-width: thin;
    z-index: 2147483647;
  }

  .dev-blueprint-bar > * {
    flex: 0 0 auto;
  }

  .dev-blueprint-bar__group {
    align-items: center;
    background: #ffffff;
    border: 1px solid #dbe3ef;
    border-radius: 999px;
    display: inline-flex;
    flex: 0 0 auto;
    gap: 8px;
    min-height: 36px;
    padding: 4px 6px 4px 12px;
  }

  .dev-blueprint-bar__group--meta {
    border-radius: 10px;
    padding-right: 12px;
  }

  .dev-blueprint-bar__group--theme {
    background: #eef6ff;
    border-color: #bfdbfe;
  }

  .dev-blueprint-bar__label {
    color: #64748b;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  :global(body:has(.dev-blueprint-bar)) {
    --dev-blueprint-toolbar-height: 52px;
  }

  :global(body:has(.dev-blueprint-bar) .public-site-root) {
    padding-top: var(--dev-blueprint-toolbar-height);
  }

  :global(body:has(.dev-blueprint-bar) .public-center-nav),
  :global(body:has(.dev-blueprint-bar) .public-fixed-cta-nav),
  :global(body:has(.dev-blueprint-bar) .public-mega-nav),
  :global(body:has(.dev-blueprint-bar) .public-nav) {
    top: var(--dev-blueprint-toolbar-height) !important;
  }

  .dev-blueprint-bar strong,
  .dev-blueprint-bar span {
    font-size: 0.82rem;
  }

  .dev-blueprint-bar span {
    color: #64748b;
  }

  .dev-blueprint-bar a[aria-current="page"] {
    background: #0f172a;
    border-color: #0f172a;
    color: #fff;
  }

  .dev-blueprint-fixtures a[aria-current="page"] {
    background: #0f172a;
    border-color: #0f172a;
    color: #fff;
  }
</style>
