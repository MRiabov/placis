{
  "id": "public.footer.logo_nav",
  "schema_version": 1,
  "display_name": "Logo Footer",
  "family": "footer",
  "variant": "logo_nav",
  "props_schema": {
    "type": "object",
    "properties": {
      "business_name": {
        "type": "string"
      },
      "logo_url": {
        "type": "string"
      },
      "logo": {
        "type": [
          "object",
          "string"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "file_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "alt_text": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "canonical_name": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "links": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "copyright": {
        "type": "string"
      },
      "legal_disclosure_lines": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "company_registration_number": {
        "type": "string"
      },
      "vat_number": {
        "type": "string"
      },
      "registered_office": {
        "type": "string"
      }
    },
    "additionalProperties": true
  },
  "editable_slots": [
    {
      "key": "business_name",
      "type": "text",
      "label": "Business name",
      "required": false,
      "max_length": null
    },
    {
      "key": "logo",
      "type": "image",
      "label": "Logo",
      "required": false,
      "max_length": null,
      "omit_if_unresolved": [
        "logo_url"
      ]
    },
    {
      "key": "links",
      "type": "list",
      "label": "Footer links",
      "required": false,
      "max_length": null
    },
    {
      "key": "copyright",
      "type": "text",
      "label": "Copyright",
      "required": false,
      "max_length": null
    },
    {
      "key": "legal_disclosure_lines",
      "type": "list",
      "label": "Legal disclosure lines",
      "required": false,
      "max_length": null
    },
    {
      "key": "company_registration_number",
      "type": "text",
      "label": "Company registration number",
      "required": false,
      "max_length": null,
      "omit_if_unresolved": [
        "company_registration_number"
      ]
    },
    {
      "key": "vat_number",
      "type": "text",
      "label": "VAT number",
      "required": false,
      "max_length": null,
      "omit_if_unresolved": [
        "vat_number"
      ]
    },
    {
      "key": "registered_office",
      "type": "text",
      "label": "Registered office",
      "required": false,
      "max_length": null,
      "omit_if_unresolved": [
        "registered_office"
      ]
    }
  ],
  "default_values": [
    {
      "path": "business_name",
      "value": "{{business_name}}"
    },
    {
      "path": "logo",
      "value": "{{images.logo}}"
    }
  ],
  "design_controls": []
}
