{
  "id": "public.footer.multi_column",
  "aliases": [],
  "schema_version": 1,
  "display_name": "Reference Footer",
  "family": "footer",
  "variant": "multi_column",
  "props_schema": {
    "type": "object",
    "properties": {
      "business_name": { "type": "string" },
      "logo": { "type": ["object", "string"], "additionalProperties": true },
      "logo_url": { "type": "string" },
      "tagline": { "type": "string" },
      "legal_line": { "type": "string" },
      "ctas": {
        "type": "array",
        "items": { "type": "object", "additionalProperties": true }
      },
      "columns": {
        "type": "array",
        "items": { "type": "object", "additionalProperties": true }
      },
      "social_links": {
        "type": "array",
        "items": { "type": "object", "additionalProperties": true }
      }
    },
    "additionalProperties": true
  },
  "editable_slots": [
    {
      "key": "business_name",
      "type": "text",
      "label": "Business name",
      "required": false,
      "max_length": null
    },
    {
      "key": "logo",
      "type": "image",
      "label": "Logo",
      "required": false,
      "max_length": null,
      "omit_if_unresolved": ["logo_url"]
    },
    {
      "key": "columns",
      "type": "list",
      "label": "Footer columns",
      "required": false,
      "max_length": 6
    },
    {
      "key": "ctas",
      "type": "list",
      "label": "Footer CTAs",
      "required": false,
      "max_length": 3
    }
  ],
  "default_values": [
    { "path": "business_name", "value": "{{business_name}}" },
    { "path": "logo", "value": "{{images.logo}}" },
    { "path": "legal_line", "value": "Copyright {{business_name}}" }
  ],
  "design_controls": []
}
