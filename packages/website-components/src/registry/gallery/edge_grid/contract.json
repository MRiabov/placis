{
  "id": "public.gallery.edge_grid",
  "schema_version": 1,
  "display_name": "Edge Grid Gallery",
  "family": "gallery",
  "variant": "edge_grid",
  "props_schema": {
    "type": "object",
    "properties": {
      "anchor_id": {
        "type": "string"
      },
      "eyebrow": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "items": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          {
            "type": "string",
            "pattern": "^\\{\\{\\s*projects\\.[a-zA-Z0-9_.]+\\s*\\}\\}$"
          }
        ]
      }
    },
    "additionalProperties": true,
    "required": [
      "title",
      "items"
    ]
  },
  "editable_slots": [
    {
      "key": "anchor_id",
      "type": "text",
      "label": "Anchor ID",
      "required": false,
      "max_length": null
    },
    {
      "key": "title",
      "type": "text",
      "label": "Title",
      "required": true,
      "max_length": null
    },
    {
      "key": "items",
      "type": "list",
      "label": "Projects",
      "required": true,
      "max_length": null
    }
  ],
  "design_controls": []
}
