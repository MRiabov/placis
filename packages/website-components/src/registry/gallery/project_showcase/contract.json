{
  "id": "public.gallery.project_showcase",
  "aliases": [],
  "schema_version": 1,
  "display_name": "Project Showcase",
  "family": "gallery",
  "variant": "project_showcase",
  "props_schema": {
    "type": "object",
    "properties": {
      "anchor_id": { "type": "string" },
      "eyebrow": { "type": "string" },
      "title": { "type": "string" },
      "projects": {
        "oneOf": [
          {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          {
            "type": "string",
            "pattern": "^\\{\\{\\s*projects\\.[a-zA-Z0-9_.]+\\s*\\}\\}$"
          }
        ]
      }
    },
    "additionalProperties": true,
    "required": ["projects"]
  },
  "editable_slots": [
    {
      "key": "anchor_id",
      "type": "text",
      "label": "Anchor ID",
      "required": false,
      "max_length": null
    },
    {
      "key": "title",
      "type": "text",
      "label": "Title",
      "required": false,
      "max_length": null
    },
    {
      "key": "projects",
      "type": "list",
      "label": "Projects",
      "required": true,
      "max_length": 8
    }
  ],
  "default_values": [
    {
      "path": "projects",
      "value": "{{projects.featured}}"
    }
  ],
  "design_controls": []
}
