{
  "id": "public.navigation.mega_menu",
  "aliases": [],
  "schema_version": 1,
  "display_name": "Reference Mega Navigation",
  "family": "navigation",
  "variant": "mega_menu",
  "props_schema": {
    "type": "object",
    "properties": {
      "business_name": { "type": "string" },
      "logo": { "type": ["object", "string"], "additionalProperties": true },
      "logo_url": { "type": "string" },
      "home_href": { "type": "string" },
      "locale_label": { "type": "string" },
      "overlay_hero": { "type": "boolean" },
      "primary_cta": { "type": "object", "additionalProperties": true },
      "links": {
        "type": "array",
        "items": { "type": "object", "additionalProperties": true }
      },
      "groups": {
        "type": "array",
        "items": { "type": "object", "additionalProperties": true }
      }
    },
    "additionalProperties": true
  },
  "editable_slots": [
    {
      "key": "business_name",
      "type": "text",
      "label": "Business name",
      "required": false,
      "max_length": null
    },
    {
      "key": "logo",
      "type": "image",
      "label": "Logo",
      "required": false,
      "max_length": null,
      "omit_if_unresolved": ["logo_url"]
    },
    {
      "key": "links",
      "type": "list",
      "label": "Top-level links",
      "required": true,
      "max_length": 12
    },
    {
      "key": "groups",
      "type": "list",
      "label": "Mega menu groups",
      "required": false,
      "max_length": 6
    }
  ],
  "default_values": [
    { "path": "business_name", "value": "{{business_name}}" },
    { "path": "logo", "value": "{{images.logo}}" }
  ],
  "design_controls": []
}
