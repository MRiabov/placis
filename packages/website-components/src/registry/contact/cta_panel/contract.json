{
  "id": "public.contact.cta_panel",
  "schema_version": 1,
  "display_name": "Contact CTA Panel",
  "family": "contact",
  "variant": "cta_panel",
  "props_schema": {
    "type": "object",
    "properties": {
      "eyebrow": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "marketing_phone": {
        "type": "string"
      },
      "whatsapp_url": {
        "type": "string"
      },
      "email_label": {
        "type": "string"
      },
      "phone_label": {
        "type": "string"
      },
      "whatsapp_label": {
        "type": "string"
      }
    },
    "additionalProperties": true,
    "required": [
      "title"
    ]
  },
  "editable_slots": [
    {
      "key": "title",
      "type": "text",
      "label": "Title",
      "required": true,
      "max_length": null
    },
    {
      "key": "description",
      "type": "textarea",
      "label": "Description",
      "required": false,
      "max_length": null
    },
    {
      "key": "email",
      "type": "text",
      "label": "Email",
      "required": false,
      "max_length": null
    },
    {
      "key": "marketing_phone",
      "type": "text",
      "label": "Marketing phone",
      "required": false,
      "max_length": null
    }
  ],
  "default_values": [
    {
      "path": "title",
      "value": "{{business_name}}"
    },
    {
      "path": "description",
      "value": "{{description}}"
    },
    {
      "path": "email",
      "value": "{{email}}"
    },
    {
      "path": "marketing_phone",
      "value": "{{marketing_phone}}"
    }
  ],
  "design_controls": []
}
