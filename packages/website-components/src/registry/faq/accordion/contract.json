{
  "id": "public.faq.accordion",
  "aliases": [],
  "schema_version": 1,
  "display_name": "FAQ Accordion",
  "family": "faq",
  "variant": "accordion",
  "props_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "answer": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "required": ["question", "answer"]
        },
        "minItems": 1
      }
    },
    "additionalProperties": true,
    "required": ["title", "items"]
  },
  "editable_slots": [
    {
      "key": "title",
      "type": "text",
      "label": "Title",
      "required": true,
      "max_length": null
    },
    {
      "key": "items",
      "type": "list",
      "label": "Questions",
      "required": false,
      "max_length": null
    }
  ],
  "design_controls": [
    {
      "key": "density",
      "type": "enum",
      "label": "Density",
      "values": ["compact", "comfortable", "spacious"],
      "default": "comfortable"
    }
  ]
}
