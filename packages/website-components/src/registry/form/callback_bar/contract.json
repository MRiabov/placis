{
  "id": "public.form.callback_bar",
  "schema_version": 1,
  "display_name": "Callback Bar Form",
  "family": "form",
  "variant": "callback_bar",
  "props_schema": {
    "type": "object",
    "properties": {
      "form_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "submit_label": {
        "type": "string"
      },
      "fields": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "text",
                "textarea",
                "email",
                "marketing_phone",
                "tel",
                "address",
                "select",
                "multi_select",
                "date",
                "time",
                "file_upload",
                "checkbox",
                "number"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "placeholder": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "additionalProperties": true,
                "required": [
                  "label",
                  "value"
                ]
              }
            }
          },
          "additionalProperties": true,
          "required": [
            "id",
            "label"
          ]
        },
        "minItems": 1
      }
    },
    "additionalProperties": true,
    "required": [
      "form_id",
      "title",
      "fields"
    ]
  },
  "editable_slots": [
    {
      "key": "form_id",
      "type": "form",
      "label": "Callback form",
      "required": true,
      "max_length": null
    },
    {
      "key": "title",
      "type": "text",
      "label": "Title",
      "required": true,
      "max_length": null
    },
    {
      "key": "fields",
      "type": "list",
      "label": "Fields",
      "required": true,
      "max_length": null
    }
  ],
  "design_controls": [
    {
      "key": "density",
      "type": "enum",
      "label": "Density",
      "values": [
        "compact",
        "comfortable",
        "spacious"
      ],
      "default": "comfortable"
    }
  ]
}
