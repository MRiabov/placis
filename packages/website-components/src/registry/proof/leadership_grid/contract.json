      "max_length": 80
    },
    {
      "key": "title",
      "type": "text",
      "label": "Title",
      "required": false,
      "max_length": 80
    },
    {
      "key": "items",
      "type": "list",
      "label": "Leaders",
      "required": true,
      "max_length": null
    }
  ],
  "default_values": [
    {
      "path": "items",
      "value": "{{leadership}}"
    }
  ],
  "design_controls": [
    {
      "key": "columns",
      "type": "enum",
      "label": "Columns",
      "values": ["2", "3", "4"],
      "default": "3"
    }
  ]
