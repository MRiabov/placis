          "label": "First Name",
          "type": "text",
          "required": true
        },
        {
          "id": "last_name",
          "label": "Last Name",
          "type": "text",
          "required": false
        },
        {
          "id": "email",
          "label": "Email",
          "type": "email",
          "required": true
        },
        {
          "id": "phone",
          "label": "Phone",
          "type": "phone",
          "required": true
