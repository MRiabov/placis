          "props": {
            "anchor_id": "about",
            "title": "{{business_name}}",
            "subheading": "Roofing Experts in {{service_area}}",
            "paragraphs": [
              "At {{business_name}}, we understand the importance of a sturdy and reliable roof over your head. Serving {{service_area}}, we specialise in providing top-notch roofing solutions tailored to meet your specific needs. Whether it's a minor repair or a complete roof installation, our team of experienced professionals is dedicated to ensuring quality workmanship and customer satisfaction."
            ],
            "image_url": "{{images.roofing_about_image}}",
            "alt_text": "{{business_name}} roofing project",
            "image_position": "right"
          },
          "source_refs": [
            {
              "url": "https://roofshield.ie/",
              "section": "about",
              "note": "Extracted from the source home-page about block: title 'Roof Shield', subheading 'Roofing Experts in Dublin', and one paragraph of body copy."
